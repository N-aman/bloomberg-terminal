# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real keys (task 0.8).

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Finnhub (https://finnhub.io/register)
FINNHUB_API_KEY=

# Currents API (secondary news source - replaces NewsAPI, see plan Section 7/13)
CURRENTS_API_KEY=

# Upstash Redis (https://upstash.com - REST API, not the raw redis:// URL)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Binance public REST/WS endpoints need no key - intentionally omitted.
